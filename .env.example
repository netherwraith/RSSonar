# Generate a strong value, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:8765
# Optional full public RSS URL (for reverse proxies), e.g. https://releases.example.org/rss.xml
PUBLIC_FEED_URL=
RSSONAR_BIND=0.0.0.0
POLL_MINUTES=15

# Optional: URL of an existing Signal API reachable from RSSonar.
SIGNAL_API_URL=
SIGNAL_NUMBER=
SIGNAL_RECIPIENTS=
